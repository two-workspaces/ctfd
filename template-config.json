{
  "services": {
    "cd7ca364-c934-4662-b428-d669942ab9e5": {
      "icon": "https://avatars.githubusercontent.com/u/18561578?v=4",
      "name": "CTFd",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/healthcheck",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/two-workspaces/ctfd:0a35f6b"
      },
      "variables": {
        "PORT": {
          "defaultValue": "8000",
          "description": "Port CTFd listens on - leave as is",
          "isOptional": false
        },
        "CTFD_ADMIN_NAME": {
          "defaultValue": "admin",
          "description": "Admin user name, created on first boot only (not an email address)",
          "isOptional": false
        },
        "CTFD_ADMIN_EMAIL": {
          "defaultValue": "",
          "description": "Your email - the admin account's email, created on first boot",
          "isOptional": false
        },
        "CTFD_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Admin password, set on first boot only - copy it from here to log in, then change it in CTFd",
          "isOptional": false
        },
        "CTFD_NAME": {
          "defaultValue": "My CTF",
          "description": "Event name shown on the site, set on first boot only - change it later in Admin > Config",
          "isOptional": false
        },
        "SECRET_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs sessions - auto-generated, keep it secret",
          "isOptional": false
        },
        "DATABASE_URL": {
          "defaultValue": "mysql+pymysql://ctfd:${{MariaDB.MARIADB_PASSWORD}}@${{MariaDB.RAILWAY_PRIVATE_DOMAIN}}:3306/ctfd",
          "description": "MariaDB - private network, leave as is",
          "isOptional": false
        },
        "REDIS_URL": {
          "defaultValue": "redis://default:${{Redis.REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379",
          "description": "Redis cache - private network, leave as is",
          "isOptional": false
        },
        "UPLOAD_FOLDER": {
          "defaultValue": "/var/uploads",
          "description": "Challenge files live on the volume here - leave as is",
          "isOptional": false
        },
        "REVERSE_PROXY": {
          "defaultValue": "true",
          "description": "Trust Railway's proxy for client IPs and HTTPS - leave as is",
          "isOptional": false
        },
        "WORKERS": {
          "defaultValue": "1",
          "description": "Gunicorn workers (gevent, so one handles many players). Raise with more RAM for big events",
          "isOptional": false
        },
        "RAILWAY_RUN_UID": {
          "defaultValue": "0",
          "description": "Run as root so CTFd can write to the uploads volume",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {
        "cd7ca364-c934-4662-b428-d669942ab9e5": {
          "mountPath": "/var/uploads"
        }
      }
    },
    "1fdcdb6f-208d-4580-8d1c-f0d1ba203ad1": {
      "icon": "https://raw.githubusercontent.com/devicons/devicon/master/icons/mariadb/mariadb-original.svg",
      "name": "MariaDB",
      "build": {},
      "deploy": {
        "startCommand": "docker-entrypoint.sh mariadbd --datadir=/var/lib/mysql/data --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci --wait_timeout=28800",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "mariadb:11.8.9"
      },
      "variables": {
        "MARIADB_ROOT_PASSWORD": {
          "defaultValue": "${{secret(32)}}",
          "description": "Auto-generated root password",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Time for MariaDB to shut down cleanly on redeploy",
          "isOptional": false
        },
        "MARIADB_DATABASE": {
          "defaultValue": "ctfd",
          "description": "Database name",
          "isOptional": false
        },
        "MARIADB_USER": {
          "defaultValue": "ctfd",
          "description": "Database user",
          "isOptional": false
        },
        "MARIADB_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated database password",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "1fdcdb6f-208d-4580-8d1c-f0d1ba203ad1": {
          "mountPath": "/var/lib/mysql"
        }
      }
    },
    "e8c22f8b-3102-4fec-bb59-f140d3ab2c5e": {
      "icon": "https://devicons.railway.app/i/redis.svg",
      "name": "Redis",
      "build": {},
      "deploy": {
        "startCommand": "/bin/sh -c \"exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --save '' --appendonly no\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "redis:8.10.2-alpine"
      },
      "variables": {
        "REDIS_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated Redis password",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      }
    }
  }
}